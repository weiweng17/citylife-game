# ============================================================ 工具

## 根据年龄返回人生阶段 key
static func age_bucket(age: int) -> String:
	if age < 31:
		return "young"
	if age < 46:
		return "mid"
	return "old"


## 取当前年龄段该 NPC 的对话
static func npc_lines(npc: Dictionary, age: int) -> Array:
	return npc.get("lines", {}).get(age_bucket(age), ["……"])


## 暗线是否解锁
static func dark_ready(npc: Dictionary, age: int) -> bool:
	var d: Dictionary = npc.get("dark", {})
	if d.is_empty():
		return false
	return age >= int(d.get("age_min", 999))
